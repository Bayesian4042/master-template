{
	"name": "@repo/shared",
	"version": "0.0.0",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"private": true,
	"scripts": {
		"build": "rm -rf dist && tsc --build --force tsconfig.json",
		"dev": "tsc --build --watch ./tsconfig.json",
		"package": "pnpm run build",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@repo/db": "workspace:*"
	},
	"devDependencies": {
		"@repo/typescript-config": "workspace:*",
		"typescript": "catalog:"
	}
}
